{
  "name": "example",
  "private": true,
  "version": "1.20.0",
  "license": "Apache 2.0",
  "scripts": {
    "build": "gatsby build --prefix-paths",
    "build:clean": "npm run clean && gatsby build",
    "build:prefix": "gatsby build --prefix-paths",
    "dev": "gatsby develop -H 0.0.0.0",
    "dev:clean": "gatsby clean && gatsby develop -H 0.0.0.0",
    "clean": "gatsby clean",
    "deploy": "gh-pages -d public",
    "predeploy": "npm run build",
    "serve": "gatsby serve",
    "format": "prettier --write \"**/*.{css,scss,json,html,yaml}\"",
    "serve:prefix": "gatsby serve --prefix-paths",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.92.0",
    "@carbon/react": "^1.120.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-theme-carbon": "^4.4.2",
    "ibm-video-streaming-web-player-api": "^1.3.3",
    "md5": "^2.3.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "smooth-scroll": "^16.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.29.13",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "classnames": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gatsby-cli": "^5.16.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-scss": "^7.5.0"
  },
  "overrides": {
    "@reach/router": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "xml2js": "^0.6.2",
    "micromatch": "^4.0.8",
    "resolve-url-loader": "^5.0.0"
  },
  "eslintIgnore": [
    "**/node_modules/",
    "**/public/",
    "**/.cache/",
    "**/build/"
  ],
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.{css,scss,json,html,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ]
  }
}
